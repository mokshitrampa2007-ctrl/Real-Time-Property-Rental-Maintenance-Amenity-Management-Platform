# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/property_management?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# JWT / Cookie Security
JWT_SECRET="super-secure-production-ready-jwt-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="prop_mgmt_token"
COOKIE_SECURE=false

# Upload Storage (local or s3)
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"

# AWS S3 Settings (Required only if STORAGE_DRIVER=s3)
# S3_BUCKET_NAME=my-property-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
