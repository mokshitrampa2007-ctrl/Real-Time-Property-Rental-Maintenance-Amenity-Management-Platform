{
  "name": "property-management-platform",
  "version": "1.0.0",
  "description": "Real-Time Property Rental, Maintenance & Amenity Management Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs watch server/src/server.ts",
    "dev:client": "node ./node_modules/vite/bin/vite.js client",
    "build:server": "node ./node_modules/prisma/build/index.js generate --schema server/prisma/schema.prisma && node ./node_modules/typescript/bin/tsc --project server/tsconfig.json",
    "build:client": "node ./node_modules/typescript/bin/tsc --project client/tsconfig.json --noEmit && node ./node_modules/vite/bin/vite.js build client",
    "build": "npm run build:server && npm run build:client",
    "vercel-build": "node ./node_modules/prisma/build/index.js generate --schema server/prisma/schema.prisma && npm run build:client",
    "start": "node server/dist/server.js",
    "test": "node ./node_modules/vitest/vitest.mjs run server/tests/",
    "db:start": "node ./node_modules/tsx/dist/cli.mjs server/src/scripts/start-embedded-db.ts",
    "db:constraint": "node ./node_modules/tsx/dist/cli.mjs server/src/scripts/apply-exclusion-constraint.ts",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs server/prisma/seed.ts && node ./node_modules/tsx/dist/cli.mjs server/src/scripts/apply-exclusion-constraint.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "msedge-tts": "^2.1.1",
    "playwright": "^1.64.1"
  }
}
