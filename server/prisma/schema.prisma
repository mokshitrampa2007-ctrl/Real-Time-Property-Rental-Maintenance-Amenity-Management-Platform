generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TENANT
  STAFF
}

enum TenancyStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  PEST_CONTROL
  GENERAL
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ownedProperties           Property[]                  @relation("PropertyOwner")
  tenancies                 Tenancy[]
  staffMemberships          PropertyStaff[]
  createdInvitations        Invitation[]                @relation("InvitationCreator")
  tenantMaintenanceRequests MaintenanceRequest[]        @relation("TenantRequests")
  assignedMaintenanceTasks  MaintenanceRequest[]        @relation("AssignedStaffRequests")
  maintenanceComments       MaintenanceComment[]
  uploadedAttachments       MaintenanceAttachment[]
  statusHistoryChanges      MaintenanceStatusHistory[]
  bookings                  AmenityBooking[]
  notifications             Notification[]
  auditLogs                 AuditLog[]

  @@index([role])
}

model Property {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  address     String
  description String?
  timeZone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner               User                 @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  units               Unit[]
  tenancies           Tenancy[]
  staffMembers        PropertyStaff[]
  invitations         Invitation[]
  maintenanceRequests MaintenanceRequest[]
  amenities           Amenity[]
  bookings            AmenityBooking[]
  auditLogs           AuditLog[]

  @@index([ownerId])
}

model Unit {
  id          String  @id @default(uuid())
  propertyId  String
  unitNumber  String
  floor       Int     @default(1)
  description String?

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancies           Tenancy[]
  invitations         Invitation[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
}

model Tenancy {
  id         String        @id @default(uuid())
  tenantId   String
  unitId     String
  propertyId String
  startDate  DateTime
  endDate    DateTime?
  status     TenancyStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([unitId, status])
  @@index([propertyId])
}

model PropertyStaff {
  id         String   @id @default(uuid())
  propertyId String
  staffId    String
  roleTitle  String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staff    User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([propertyId, staffId])
  @@index([propertyId])
  @@index([staffId])
}

model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  propertyId  String
  unitId      String?
  role        Role
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  creator   User     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([propertyId])
}

model MaintenanceRequest {
  id              String              @id @default(uuid())
  tenantId        String
  propertyId      String
  unitId          String
  assignedStaffId String?
  title           String
  description     String
  category        MaintenanceCategory
  priority        MaintenancePriority
  status          MaintenanceStatus   @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant        User                       @relation("TenantRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedStaff User?                      @relation("AssignedStaffRequests", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  comments      MaintenanceComment[]
  attachments   MaintenanceAttachment[]
  statusHistory MaintenanceStatusHistory[]

  @@index([tenantId])
  @@index([propertyId, status])
  @@index([assignedStaffId])
}

model MaintenanceComment {
  id        String   @id @default(uuid())
  requestId String
  authorId  String
  message   String
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model MaintenanceAttachment {
  id           String   @id @default(uuid())
  requestId    String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model MaintenanceStatusHistory {
  id             String            @id @default(uuid())
  requestId      String
  previousStatus MaintenanceStatus
  newStatus      MaintenanceStatus
  changedById    String
  notes          String?
  createdAt      DateTime          @default(now())

  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User               @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Amenity {
  id                      String   @id @default(uuid())
  propertyId              String
  name                    String
  description             String?
  location                String?
  capacity                Int      @default(10)
  active                  Boolean  @default(true)
  approvalRequired        Boolean  @default(false)
  slotDurationMinutes     Int      @default(60)
  minimumBookingMinutes   Int      @default(30)
  maximumBookingMinutes   Int      @default(180)
  advanceBookingDays      Int      @default(14)
  cancellationCutoffMinutes Int    @default(60)
  checkInGraceMinutes     Int      @default(15)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  property       Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  operatingHours AmenityOperatingHours[]
  closures       AmenityClosure[]
  bookings       AmenityBooking[]

  @@index([propertyId])
}

model AmenityOperatingHours {
  id          String @id @default(uuid())
  amenityId   String
  weekday     Int    // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openingTime String // e.g. "08:00" (HH:mm)
  closingTime String // e.g. "22:00" (HH:mm)

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([amenityId, weekday])
  @@index([amenityId])
}

model AmenityClosure {
  id        String   @id @default(uuid())
  amenityId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId, startsAt, endsAt])
}

model AmenityBooking {
  id               String        @id @default(uuid())
  amenityId        String
  tenantId         String
  propertyId       String
  startsAt         DateTime
  endsAt           DateTime
  attendeeCount    Int           @default(1)
  status           BookingStatus @default(CONFIRMED)
  rejectionReason  String?
  actualCheckInAt  DateTime?
  actualCheckOutAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([amenityId, startsAt, endsAt])
  @@index([tenantId])
  @@index([propertyId, status])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  propertyId String?
  metadata   String?
  createdAt  DateTime @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([entityType, entityId])
}
